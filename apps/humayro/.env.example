# This public URL is embedded in the browser bundle during `next build`.
NEXT_PUBLIC_API_URL=https://swagger.humayro.uz
NEXT_PUBLIC_SITE_URL=https://humayro.uz

# Public by design, but keep the production value in the GitHub Actions secret.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Reserved for server-side OAuth integration. Never prefix these with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=https://humayro.uz/api/auth/google/callback
GOOGLE_CLIENT_SECRET=
