# Local development defaults. CI overrides these values for main/production.
# These public URLs are embedded in the browser bundle during `next build`.
NEXT_PUBLIC_API_URL=https://dev-api.humayro.uz
NEXT_PUBLIC_SITE_URL=https://dev.humayro.uz

# Public by design, but keep the production value in the GitHub Actions secret.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Reserved for server-side OAuth integration. Never prefix these with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=https://dev.humayro.uz/api/auth/google/callback
GOOGLE_CLIENT_SECRET=
